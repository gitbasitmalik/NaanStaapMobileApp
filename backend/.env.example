# MongoDB connection (Atlas or self-hosted)
MONGO_URL=mongodb://localhost:27017
DB_NAME=naanstaap
PORT=8005

# Long random strings — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Key the store/kitchen tools send in the x-staff-key header to update order status
STAFF_API_KEY=

# Ordering rules (GBP)
DELIVERY_FEE=2.99
FREE_DELIVERY_THRESHOLD=25
MIN_ORDER_AMOUNT=5

# Demo/testing only — leave false in production
DEMO_AUTO_PROGRESS=false
ALLOW_ORDERS_WHEN_CLOSED=false
